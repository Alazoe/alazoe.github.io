.nav-cta:hover{background:var(--gold2)!important}

/* HERO */
.hero{min-height:100vh;display:grid;grid-template-rows:1fr auto;background:var(--g1);position:relative;overflow:hidden;padding-top:64px}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 70% 40%,rgba(45,106,79,.35) 0%,transparent 70%),radial-gradient(ellipse 50% 40% at 10% 80%,rgba(201,168,76,.10) 0%,transparent 60%);pointer-events:none}
.hero-inner{display:flex;flex-direction:column;justify-content:center;padding:80px 64px 40px;max-width:900px;position:relative;z-index:2}
.hero-tag{display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-size:11px;color:var(--gold);letter-spacing:.14em;text-transform:uppercase;margin-bottom:28px;opacity:0;animation:fadeUp .8s .2s ease forwards}
.hero-tag::before{content:'';display:block;width:28px;height:1px;background:var(--gold)}
.hero-h1{font-family:var(--serif);font-size:clamp(36px,6vw,68px);line-height:1.08;color:#fff;font-weight:400;margin-bottom:8px;opacity:0;animation:fadeUp .9s .35s ease forwards}
.hero-h1 em{font-style:italic;color:#b7e4c7}
.hero-h1 strong{display:block;color:var(--gold2);font-weight:700}
.hero-sub{font-size:17px;color:#7abf93;margin-top:24px;max-width:520px;font-weight:300;line-height:1.65;opacity:0;animation:fadeUp .9s .5s ease forwards}
.hero-author{display:flex;align-items:center;gap:16px;margin-top:48px;padding-top:28px;border-top:1px solid rgba(255,255,255,.1);opacity:0;animation:fadeUp .9s .65s ease forwards}
.hero-author-name{font-size:14px;font-weight:600;color:#e0f0e6;line-height:1.3}
.hero-author-role{font-size:12px;color:#7abf93;font-weight:300}
.hero-dot{width:8px;height:8px;background:var(--gold);border-radius:50%;animation:pulse 2s infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.hero-scroll{padding:24px 64px 32px;position:relative;z-index:2;opacity:0;animation:fadeUp .9s .8s ease forwards}
.hero-scroll a{display:inline-flex;align-items:center;gap:10px;color:#5a9e72;font-size:12px;font-family:var(--mono);text-decoration:none;letter-spacing:.06em;text-transform:uppercase;transition:color .2s}
.hero-scroll a:hover{color:var(--gold)}
.scroll-arrow{display:inline-block;animation:bounce 2s infinite}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

/* INTRO BAND */
.intro-band{background:var(--g2);padding:80px 64px;position:relative;overflow:hidden}
.intro-band::before{content:'';position:absolute;top:-60px;right:-60px;width:320px;height:320px;border-radius:50%;background:rgba(82,183,136,.08)}
.intro-band-inner{max-width:1140px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.intro-band h2{font-family:var(--serif);font-size:clamp(24px,3vw,38px);color:#fff;font-weight:400;line-height:1.25;margin-bottom:20px}
.intro-band h2 em{color:var(--gold2)}
.intro-band p{color:#8dc8a3;font-size:16px;line-height:1.75;margin-bottom:16px}
.intro-alert{background:rgba(201,168,76,.12);border:1px solid rgba(201,168,76,.3);border-radius:8px;padding:16px 20px;margin-top:24px}
.intro-alert p{color:var(--gold2)!important;font-size:14px!important;margin:0;font-style:italic}
.intro-checklist{list-style:none}
.intro-checklist li{display:flex;align-items:flex-start;gap:14px;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.07);color:#a8d5b5;font-size:15px;line-height:1.5}
.intro-checklist li:last-child{border-bottom:none}
.ic-mark{width:22px;height:22px;border-radius:50%;background:rgba(82,183,136,.2);border:1px solid rgba(82,183,136,.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:11px;color:var(--g4);margin-top:1px}
.ic-body strong{color:#d4ead9}

/* LAYOUT */
.page-layout{display:grid;grid-template-columns:210px 1fr;gap:0;max-width:1100px;margin:0 auto;padding:80px 32px;align-items:start}
.toc-sticky{position:sticky;top:88px;padding-right:36px}
.toc-label{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--g3);margin-bottom:16px;font-weight:500}
.toc-list{list-style:none;border-left:2px solid var(--rule)}
.toc-list li a{display:block;padding:7px 0 7px 16px;font-size:13px;color:var(--ink3);text-decoration:none;line-height:1.4;transition:color .2s,border-color .2s;border-left:2px solid transparent;margin-left:-2px}
.toc-list li a:hover,.toc-list li a.active{color:var(--g2);border-left-color:var(--g3)}
.toc-list .toc-n{font-family:var(--mono);font-size:10px;color:var(--gold);display:block;margin-bottom:1px}

/* SECTIONS */
.section{margin-bottom:96px;scroll-margin-top:88px;opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
.section.visible{opacity:1;transform:translateY(0)}
.sec-head{display:flex;align-items:flex-start;gap:20px;margin-bottom:32px;padding-bottom:24px;border-bottom:1px solid var(--rule)}
.sec-num{font-family:var(--mono);font-size:11px;color:var(--gold);letter-spacing:.1em;text-transform:uppercase;margin-bottom:6px}
.sec-icon{width:52px;height:52px;border-radius:14px;background:var(--g2);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;box-shadow:0 4px 16px rgba(27,67,50,.25)}
.sec-title h2{font-family:var(--serif);font-size:clamp(22px,2.5vw,30px);color:var(--g1);font-weight:700;line-height:1.2}
.lead{font-family:var(--serif);font-size:18px;line-height:1.65;color:var(--g2);font-style:italic;border-left:3px solid var(--g4);padding:12px 20px;margin-bottom:28px;background:var(--g6);border-radius:0 8px 8px 0}
p{margin-bottom:18px;line-height:1.8;color:var(--ink2)}
p strong{color:var(--ink)}
p:last-child{margin-bottom:0}

/* LISTS */
.elist{list-style:none;margin:24px 0;border:1px solid var(--rule);border-radius:10px;overflow:hidden}
.elist li{display:grid;grid-template-columns:48px 1fr;border-bottom:1px solid var(--rule)}
.elist li:last-child{border-bottom:none}
.elist-num{background:var(--g2);color:var(--gold);font-family:var(--mono);font-size:13px;font-weight:500;display:flex;align-items:center;justify-content:center;padding:14px 0}
.elist-text{padding:14px 18px;font-size:15px;line-height:1.6;background:#fff;transition:background .2s}
.elist li:hover .elist-text{background:var(--g6)}
.elist-text strong{color:var(--g2)}
.blist{list-style:none;margin:16px 0}
.blist li{display:flex;gap:12px;padding:10px 0;font-size:15px;border-bottom:1px dashed var(--rule);line-height:1.6}
.blist li:last-child{border-bottom:none}
.blist li::before{content:'→';color:var(--g4);font-family:var(--mono);font-size:13px;flex-shrink:0;margin-top:2px}

/* TIP */
.tip{position:relative;background:var(--gold-bg);border:1px solid #e8d4a0;border-radius:10px;padding:24px 28px 24px 32px;margin:32px 0;overflow:hidden}
.tip::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(to bottom,var(--gold),var(--gold2))}
.tip-label{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;font-weight:600}
.tip p{font-style:italic;font-size:15px;color:#5a4720;margin-bottom:0;line-height:1.7}

/* KPIs */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:14px;margin:28px 0}
.kpi{background:#fff;border:1px solid var(--rule);border-radius:10px;padding:20px 16px;text-align:center;transition:transform .2s,box-shadow .2s;position:relative;overflow:hidden}
.kpi::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(to right,var(--g3),var(--g4))}
.kpi:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(27,67,50,.12)}
.kpi-val{font-family:var(--serif);font-size:32px;font-weight:700;color:var(--g2);line-height:1;margin-bottom:8px}
.kpi-desc{font-size:12px;color:var(--ink3);line-height:1.4}

/* FORMULA */
.formula{background:var(--g1);border-radius:10px;padding:24px 28px;margin:24px 0;text-align:center;position:relative;overflow:hidden}
.formula::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 60% at 50% 0%,rgba(82,183,136,.15) 0%,transparent 70%)}
.formula-lbl{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--g4);margin-bottom:12px}
.formula-eq{font-family:var(--serif);font-size:22px;color:#fff;font-style:italic;position:relative;z-index:1}
.formula-eq strong{color:var(--gold2)}
h3{font-family:var(--sans);font-size:13px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--g2);margin:32px 0 14px;display:flex;align-items:center;gap:10px}
h3::after{content:'';flex:1;height:1px;background:var(--rule)}
.div{border:none;height:1px;background:var(--rule);margin:64px 0}

/* CTA */
.cta-section{background:var(--g1);position:relative;overflow:hidden;padding:100px 64px;text-align:center}
.cta-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 60% at 50% 0%,rgba(201,168,76,.12) 0%,transparent 60%),radial-gradient(ellipse 40% 40% at 80% 100%,rgba(45,106,79,.25) 0%,transparent 60%)}
.cta-inner{position:relative;z-index:1;max-width:620px;margin:0 auto}
.cta-eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:20px}
.cta-inner h2{font-family:var(--serif);font-size:clamp(26px,4vw,44px);color:#fff;font-weight:400;line-height:1.2;margin-bottom:16px}
.cta-inner h2 em{font-style:italic;color:var(--gold2)}
.cta-inner p{color:#7abf93;font-size:16px;margin-bottom:40px;font-weight:300}
.cta-btns{display:flex;justify-content:center;flex-wrap:wrap;gap:14px;margin-bottom:40px}
.btn-gold{display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:var(--g1);font-weight:600;font-size:14px;padding:14px 28px;border-radius:40px;text-decoration:none;transition:background .2s,transform .2s;letter-spacing:.01em}
.btn-gold:hover{background:var(--gold2);transform:translateY(-2px)}
.btn-ghost{display:inline-flex;align-items:center;gap:8px;background:transparent;color:#a8d5b5;font-size:14px;padding:14px 28px;border-radius:40px;text-decoration:none;border:1px solid rgba(255,255,255,.18);transition:border-color .2s,color .2s}
.btn-ghost:hover{border-color:var(--g4);color:#fff}
.cta-row{display:flex;justify-content:center;align-items:center;gap:24px;flex-wrap:wrap;padding-top:28px;border-top:1px solid rgba(255,255,255,.08)}
.cta-row a{font-family:var(--mono);font-size:12px;color:#5a9e72;text-decoration:none;transition:color .2s}
.cta-row a:hover{color:var(--gold2)}
.cta-sep{color:#1b4332}

/* FOOTER */
.footer{background:#080f0b;padding:28px 48px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}
.footer img{height:30px;opacity:.7;filter:brightness(1.5)}
.footer-text{font-size:12px;color:#3d6650;text-align:right;line-height:1.6}
.footer-text a{color:var(--g4);text-decoration:none}

/* PROGRESS */
.pbar{position:fixed;top:64px;left:0;height:2px;background:linear-gradient(to right,var(--g4),var(--gold));z-index:101;width:0%;transition:width .1s linear}

/* RESPONSIVE */
@media(max-width:900px){
  .page-layout{grid-template-columns:1fr;padding:48px 24px}
  .toc-sticky{display:none}
  .hero-inner{padding:60px 28px 32px}
  .hero-scroll{padding:16px 28px 24px}
  .intro-band{padding:56px 28px}
  .intro-band-inner{grid-template-columns:1fr;gap:40px}
  .cta-section{padding:72px 28px}
  .footer{padding:24px 28px}
  .nav-links{display:none}
}
@media(max-width:600px){
  .hero-h1{font-size:30px}
  .kpis{grid-template-columns:repeat(2,1fr)}
  .cta-btns{flex-direction:column;align-items:stretch;text-align:center}
}
</style>
